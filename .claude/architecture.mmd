flowchart TB
    subgraph POLICY["Policy layer — ScreenWeave: goal, allowed domains, forbidden actions, step/cost/time budgets, stop conditions"]
        direction TB
        subgraph LOOP["Explore loop — observe → decide → act → observe"]
            direction LR
            OBS["Observe<br/>screenshot + candidate elements<br/>(role, name, bbox)"]
            DEC["Decide next action<br/>(policy-checked)"]
            ACT["Act"]
            OBS --> DEC --> ACT --> OBS
        end
        subgraph RESOLVE["Element resolution — fallback order"]
            direction LR
            SEL["1 · Deterministic Playwright<br/>selector / scripted flow"]
            INT["2 · Intent locator<br/>vision-language model,<br/>confidence ≥ threshold"]
            SAFE["3 · Fail safe<br/>no action, report"]
            SEL -- miss --> INT -- no confident match --> SAFE
        end
        ACT --> SEL
    end

    LOOP -- "states,<br/>screenshots" --> ART[("Artifacts<br/>S3")]

    subgraph CHAIN["QA sign-off chain"]
        direction LR
        L1["L1 · first-pass reviewer<br/>small model · every state<br/>→ structured findings"]
        L2["L2 · senior-QA reviewer<br/>stronger model · escalations only<br/>confirm / dismiss / reclassify"]
        L3["L3 · human sign-off<br/>flagged findings only<br/>only level that approves a release"]
        L1 -- "escalate:<br/>severity, low confidence,<br/>category" --> L2
        L2 -- "critical, unsure,<br/>downgraded critical,<br/>budget or error" --> L3
    end

    ART --> L1
    L3 --> REL{{"Release:<br/>approved · rejected ·<br/>needs-changes"}}
    REL -. "recorded" .-> AUD[("qa_report.json + sign-off record<br/>append-only audit trail:<br/>who or what signed each level")]
